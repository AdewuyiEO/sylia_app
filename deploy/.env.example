# Copy to .env on the server (setup-server.sh does this and fills the secrets).
# Never commit .env.

# your API's address, e.g. api.sylia.app (DNS A record → this server's IP)
DOMAIN=

# generated by setup-server.sh — keep them; changing JWT_SECRET logs everyone out,
# changing ENCRYPTION_KEY makes stored calendar tokens unreadable
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_TOKEN=

# paste your own keys (leave blank to switch the feature off)
ANTHROPIC_API_KEY=
OPENWEATHER_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
