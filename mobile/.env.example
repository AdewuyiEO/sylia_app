# Where the app finds the backend. Local: your PC's LAN IP (ipconfig), e.g.
# http://192.168.1.20:8000 — the phone isn't your computer, so not localhost.
# TestFlight/production builds take this from eas.json instead.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# RevenueCat public SDK key (App Store). Empty = purchases disabled, trial only.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Legal pages shown at sign-up and in Settings
EXPO_PUBLIC_PRIVACY_URL=https://sylia.app/privacy
EXPO_PUBLIC_TERMS_URL=https://sylia.app/terms
