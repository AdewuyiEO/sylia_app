{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.20:8000"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sylia.app",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "",
        "EXPO_PUBLIC_PRIVACY_URL": "https://sylia.app/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://sylia.app/terms"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sylia.app",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "",
        "EXPO_PUBLIC_PRIVACY_URL": "https://sylia.app/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://sylia.app/terms"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
