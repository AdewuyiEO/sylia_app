ENV=dev
DATABASE_URL=postgresql+psycopg://sylia:sylia@localhost:5432/sylia
REDIS_URL=redis://localhost:6379/0
REQUIRE_REDIS=false            # true in prod when a separate Celery worker runs

# the URL phones use to reach this API (local uploads, OAuth callbacks).
# On your LAN: http://<PC-LAN-IP>:8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=                  # comma-separated web origins; native apps need none

JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=            # optional; generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
MIN_PASSWORD_LENGTH=8
AUTH_RATE_LIMIT_PER_MIN=10
APPLE_BUNDLE_ID=com.sylia.stylist
ADMIN_TOKEN=               # guards /v1/admin (brand onboarding)

S3_BUCKET=sylia-dev
S3_ENDPOINT_URL=            # set to your R2 endpoint to use Cloudflare R2
UPLOAD_MAX_BYTES=15728640

# --- LLM provider (swappable) ---
LLM_PROVIDER=anthropic          # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_COACH=gpt-4o
OPENAI_MODEL_EXPLANATION=gpt-4o-mini
MODEL_EXPLANATION=claude-haiku-4-5-20251001
MODEL_COACH=claude-sonnet-5

OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=               # Google Calendar connect (OAuth web client)
GOOGLE_CLIENT_SECRET=

# billing: in-app purchases via RevenueCat; Stripe for web
REVENUECAT_WEBHOOK_SECRET=      # the Authorization value set on the RevenueCat webhook
REVENUECAT_ENTITLEMENT=pro
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_USD=19

INSIGHTS_MIN_COHORT=10          # brand insights suppress smaller groups
